# .streamlit/secrets.toml (Optional for local testing)
# For local testing, defaults are used automatically (Organizer password: admin123)
# NEVER commit secrets.toml with real secrets to GitHub.

[organizer]
password = "admin123"

[event]
name = "The Lost Algorithm"
date = "2026-12-15T10:00:00"
duration_minutes = 60
max_attempts_per_question = 3
hint_penalty = 5
speed_bonus_enabled = true
